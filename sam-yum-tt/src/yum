#!/bin/bash
# yum — package installs on the Atari TT from the SAM mirror (tt030-rpm-pipeline FR-3).
#
#   yum makecache              fetch index.signed, verify signature + serial (no replay)
#   yum list [PATTERN]         name version-release of mirror packages (all, or matching)
#   yum search PATTERN         like list, matching name or provides
#   yum install [--nodeps] PKG...
#   yum remove PKG...
#
# install fetches and SHA-256-verifies the WHOLE closure before the first rpm -i, so a network
# drop never leaves half a closure installed; a re-run refetches only what is missing or bad.
# Then one plain `rpm -i` over the set (rpm orders it). An unmet requirement is reported and the
# install stops; --nodeps is the operator saying "install anyway".
# Exit: 0 done · 1 failure (message says which) · 2 usage.
# bash, not /bin/sh: the TT's /bin/sh (bash-2.05a's minimal build, 307 KB) has no `kill` builtin and
# there is no /bin/kill, so build-on-miss could not tell a live subscriber from a dead one.
MIRROR=${MIRROR:-http://mirror.sam.int/tt030}
CACHE=/var/cache/yum.tt
KEY=/etc/yum.tt/index.pub
LIB=/usr/lib/yum.tt
[ -f /etc/yum.tt.conf ] && . /etc/yum.tt.conf
# Without UNIXMODE mintlib reads files in text mode (CRLF->LF): openssl mis-hashes, rpm -i fails
# `cpio: read`. ssh sessions lacked it until rc.dropbear passed -e (2026-09-21); keep the guard.
: "${UNIXMODE:=/brUs}"
export UNIXMODE

die() { echo "yum: $*" >&2; exit 1; }
sha256() { openssl dgst -sha256 "$1" | sed 's/.*= //'; }

makecache() {
    # index.signed = 256-byte RSA signature + index (one GET, so never a mismatched pair); the
    # index's first line is "#serial<TAB>N". A lower N than the last accepted is a replay.
    mkdir -p "$CACHE" || die "cannot create $CACHE"
    t=$CACHE/new
    wget -q -T 60 -O "$t.signed" "$MIRROR/index.signed" || { rm -f "$t".*; die "cannot fetch $MIRROR/index.signed"; }
    head -c 256 "$t.signed" > "$t.sig" && tail -c +257 "$t.signed" > "$t.tsv"
    openssl dgst -sha256 -verify "$KEY" -signature "$t.sig" "$t.tsv" >/dev/null 2>&1 \
        || { rm -f "$t".*; die "index signature does NOT verify — refusing it"; }
    new=$(sed -n '1s/^#serial	//p' "$t.tsv")
    old=$(cat "$CACHE/serial" 2>/dev/null || echo 0)
    case $new in ''|*[!0-9]*) rm -f "$t".*; die "index has no serial — refusing it" ;; esac
    if [ "$new" -lt "$old" ]; then
        rm -f "$t".*; die "index serial $new is older than $old already seen — refusing a replay"
    fi
    mv "$t.tsv" "$CACHE/index.tsv" && echo "$new" > "$CACHE/serial"
    rm -f "$t".*
    [ "$new" = "$old" ] && echo "yum: index unchanged (serial $new)" \
        || echo "yum: index verified, serial $new, $(grep -vc '^#' "$CACHE/index.tsv") packages"
}

need_cache() { [ -f "$CACHE/index.tsv" ] || makecache; }
# install re-reads an index older than 10 min: a cached index can name a package the mirror has
# since dropped or replaced (seen 2026-09-21: pv removed from built/, the stale cache 404'd).
fresh_cache() { [ -n "$(find "$CACHE/index.tsv" -mmin -10 2>/dev/null)" ] || makecache; }

# FR-4 build-on-miss: ask ttbuildd on fractal to cross-build PKG. Subscribes to the request's own
# reply topics BEFORE publishing (ttmqtt -S says when that is live), prints each status as it
# arrives, and returns 0 only on `done`. The id rides the topic, so no JSON is parsed here.
# Optional credentials for the broker ACL: /etc/yum.tt/mqtt.cred sets MQTT_USER / MQTT_PASS.
build_on_miss() {
    pkg=$1
    rid=$(od -An -N6 -tx1 /dev/urandom | tr -d ' \n')-$$
    auth=
    [ -r /etc/yum.tt/mqtt.cred ] && . /etc/yum.tt/mqtt.cred && auth="-u $MQTT_USER -P $MQTT_PASS"
    out=$CACHE/build.$rid
    echo "yum: $pkg not on the mirror — requesting a build from sam (request $rid)"
    # shellcheck disable=SC2086 # $auth is empty or two flags
    ttmqtt sub -S -W 900 $auth -E /done/ -E /failed/ -E /queued/ "sam/tt030/build/+/$rid" > "$out" 2>&1 &
    sp=$!
    n=0
    until grep -q '^SUBSCRIBED' "$out" 2>/dev/null; do
        kill -0 $sp 2>/dev/null || { cat "$out" >&2; rm -f "$out"; die "cannot subscribe to the broker"; }
        n=$((n + 1)); [ $n -gt 60 ] && { kill $sp; rm -f "$out"; die "broker did not acknowledge the subscription"; }
        sleep 1
    done
    # shellcheck disable=SC2086
    ttmqtt pub $auth sam/tt030/build/request "{\"request_id\":\"$rid\",\"pkg\":\"$pkg\"}" \
        || { kill $sp; rm -f "$out"; die "cannot publish the build request (broker unreachable or refused)"; }
    shown=1
    while :; do
        running=; kill -0 $sp 2>/dev/null && running=1
        total=$(wc -l < "$out")
        if [ "$total" -gt "$shown" ]; then
            sed -n "$((shown + 1)),${total}p" "$out" | awk '{ n = split($1, t, "/"); v = t[n - 1]; $1 = ""; sub(/^ /, ""); print "yum: build " v ": " $0 }'
            shown=$total
        fi
        [ -n "$running" ] || break
        sleep 3
    done
    wait $sp; rc=$?
    verb=$(tail -1 "$out" | awk '{ n = split($1, t, "/"); print t[n - 1] }')
    rm -f "$out"
    [ $rc -eq 1 ] && die "no answer from the build service within 15 min (request $rid)"
    [ $rc -eq 0 ] || die "lost the broker while waiting (request $rid)"
    case $verb in
        done) return 0 ;;
        queued) die "$pkg has no build recipe yet; sam queued it for a human (request $rid)" ;;
        *) die "build of $pkg failed (request $rid)" ;;
    esac
}

cmd=$1
[ -n "$cmd" ] && shift
case "$cmd" in
makecache) makecache ;;
list|search)
    need_cache
    [ "$cmd" = search ] && [ -z "$1" ] && { echo "usage: yum search PATTERN" >&2; exit 2; }
    awk -F'\t' -v pat="$1" -v s="$cmd" \
        '/^#/ { next } (pat == "" || index($1, pat) || (s == "search" && index($9, pat))) { print $1 "\t" $2 "-" $3 }' \
        "$CACHE/index.tsv"
    ;;
remove)
    [ $# -gt 0 ] || { echo "usage: yum remove PKG..." >&2; exit 2; }
    rpm -e "$@"
    ;;
install)
    nodeps=
    [ "$1" = --nodeps ] && { nodeps=--nodeps; shift; }
    [ $# -gt 0 ] || { echo "usage: yum install [--nodeps] PKG..." >&2; exit 2; }
    fresh_cache
    rpm -qa --queryformat '%{NAME}\n' > "$CACHE/installed" || die "rpm -qa failed"
    awk -F'\t' -v WANT="$*" -f "$LIB/resolve.awk" "$CACHE/installed" "$CACHE/index.tsv" > "$CACHE/plan" \
        || die "resolver failed"
    if grep -q '^NOTFOUND ' "$CACHE/plan"; then
        # One build round per invocation: YUM_BUILT stops a package that is still missing after a
        # "done" from triggering another build forever.
        [ -n "$YUM_BUILT" ] && { sed -n 's/^NOTFOUND /yum: still not on the mirror: /p' "$CACHE/plan" >&2; exit 1; }
        for p in $(sed -n 's/^NOTFOUND //p' "$CACHE/plan"); do build_on_miss "$p"; done
        makecache
        YUM_BUILT=1 exec "$0" install $nodeps "$@"
    fi
    if grep -q '^UNRESOLVED ' "$CACHE/plan"; then
        sed -n 's/^UNRESOLVED \([^ ]*\) \(.*\)/yum: nothing provides \1 (needed by \2)/p' "$CACHE/plan" >&2
        [ -n "$nodeps" ] || die "unmet requirements above; re-run with --nodeps to install anyway"
    fi
    grep -q '^GET ' "$CACHE/plan" || { echo "yum: nothing to do (already installed)"; exit 0; }
    files=
    while read -r verb name path sum size; do
        [ "$verb" = GET ] || continue
        f="$CACHE/pkgs/${path##*/}"
        mkdir -p "$CACHE/pkgs"
        if [ -f "$f" ] && [ "$(sha256 "$f")" = "$sum" ]; then
            echo "yum: $name cached"
        else
            echo "yum: fetching $name ($size bytes)"
            if ! wget -q -T 120 -O "$f" "$MIRROR/$path"; then
                rm -f "$f"
                # the index may be stale: re-read it once and start over, then give up loudly
                [ -n "$YUM_REFRESHED" ] && die "fetch failed: $name ($MIRROR/$path)"
                echo "yum: fetch failed for $name; re-reading the index"
                makecache
                YUM_REFRESHED=1 exec "$0" install $nodeps "$@"
            fi
            [ "$(sha256 "$f")" = "$sum" ] || { rm -f "$f"; die "SHA-256 mismatch: $name — not installed"; }
        fi
        files="$files $f"
    done < "$CACHE/plan"
    echo "yum: all packages verified; installing"
    # shellcheck disable=SC2086 # one word per package file, none contain spaces
    rpm -i $nodeps $files || die "rpm -i failed (files kept in $CACHE/pkgs)"
    rm -f $files
    echo "yum: installed"
    ;;
*) sed -n '3,8p' "$0" | sed 's/^# //' >&2; exit 2 ;;
esac
