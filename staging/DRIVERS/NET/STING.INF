# STiNG TCP/IP Stack Configuration File for Atari TT030
# SAM TT-Bridge Subnet Configuration Example

# Network Interface Settings (DaynaPORT SCSI Ethernet)
USERNAME = TT030
HOSTNAME = atari-tt030
NAMESERVER = 192.168.1.1
DEFAULT_DIR = C:\STING\

# DAYNAPRT.STX Configuration (SCSI ID 3)
INTERFACE = eth0
DRIVER = DAYNAPRT.STX
IP_ADDR = 192.168.1.80
NETMASK = 255.255.255.0
GATEWAY = 192.168.1.1
MTU = 1500
