; XBOOT III Configuration File for Atari TT030
[GLOBAL]
TIMEOUT=5
DEFAULT_SET=1
TURBO_BOOT=ON

[SET_1]
NAME=Standard TT030 (TOS 3.06 + STiNG + Network)
AUTO=C:\AUTO\ICD_BOOT.PRG, C:\AUTO\STING.PRG
ACC=C:\STING\STING.ACC, C:\SELECTR.ACC

[SET_2]
NAME=Minimal TOS Boot (Gaming / Low RAM)
AUTO=C:\AUTO\ICD_BOOT.PRG
ACC=

[SET_3]
NAME=FreeMiNT Multi-Tasking Kernel
AUTO=C:\AUTO\ICD_BOOT.PRG, C:\AUTO\MINT.PRG
ACC=
