emulator/fr8/
!/sam-yum-tt/build/
/sam-yum-tt/build/*
!/sam-yum-tt/build/.gitkeep

# Emulator working state, not sources (2026-09-17)
# TOS ROM images (Atari copyright) + saved 404 pages
emulator/roms/
# symlink into the SD card, the remote system management host-only
emulator/hd00_512.hda
emulator/staging_floppy.st
emulator/hd0/TMP/
emulator/hd0/**/*.SET
emulator/hd0/XBOOT/XBOOT.SYS
emulator/hd0/AUTO/XBOOT.DIS
__pycache__/

# Unlicensed ATW800/2 vendor pack (85 MB) — build host only, never published
staging/TRANSPUTER/

/sam-rom-tt/build/*
!/sam-rom-tt/build/.gitkeep
/sam-tram-tt/build/
/sam-job-tt/build/

# INMOS-toolset builds (.btl) link the INMOS runtime: local builds only, never on public GitHub (operator 2026-10-14).
# Rebuild them with the scripts (sam-job-tt/build_t4.sh, src/x25519bench, sam-yum-tt/t4*.sh); the files stay on disk.
*.btl
