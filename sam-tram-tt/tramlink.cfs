/* link round-trip benchmark: T425 L1 <-> Slot-1 L3; Slot-1 L1 <-> 2nd L0 (measured 2026-10-12). */
val BootLink 0;
T425 (memory = 2M) Root;
T800 (memory = 4M) Tram1, Tram2;
connection RootToHost, RootToTram1, Tram1ToTram2;
connect Root.link[BootLink] to host by RootToHost;
connect Root.link[1] to Tram1.link[3] by RootToTram1;
connect Tram1.link[1] to Tram2.link[0] by Tram1ToTram2;
process (stacksize = 2K, heapsize = 16k, interface (input HostInput, output HostOutput, output To1, input From1)) RootB;
process (stacksize = 2K, heapsize = 4k, interface (input FromRoot, output ToRoot, output To2, input From2)) Echo1;
process (stacksize = 2K, heapsize = 4k, interface (input In, output Out)) Echo2;
input HostInput;
output HostOutput;
connection HI, HO;
connect RootB.HostInput to HostInput by HI;
connect RootB.HostOutput to HostOutput by HO;
place HI on RootToHost;
place HO on RootToHost;
connect RootB.To1 to Echo1.FromRoot;
connect Echo1.ToRoot to RootB.From1;
connect Echo1.To2 to Echo2.In;
connect Echo2.Out to Echo1.From2;
use "rootb.lku" for RootB;
place RootB on Root;
use "echo1.lku" for Echo1;
place Echo1 on Tram1;
use "echo2.lku" for Echo2;
place Echo2 on Tram2;
